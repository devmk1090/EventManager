<?xml version="1.0" encoding="utf-8"?>
<!-- 백업 안내 시트: 설정의 ‘백업 방법 보기’와 처음 ‘백업 파일 저장’을 눌렀을 때 띄운다.
     단계(guide_steps)는 SettingsFragment가 item_guide_step으로 채운다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textSize="22sp" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/guide_intro"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/guide_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_guide_tip"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:text="@string/guide_tip"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guide_backup_now"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_backup_now" />
    </LinearLayout>
</ScrollView>
