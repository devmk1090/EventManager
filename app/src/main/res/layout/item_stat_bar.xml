<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/bar_label"
        style="@style/Text"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_chip"
        android:textSize="14sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/bar_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="1000"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/track"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <TextView
        android:id="@+id/bar_amount"
        style="@style/Text.Amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/pretendard_semibold"
        app:fontFamily="@font/pretendard_semibold"
        android:gravity="end"
        android:minWidth="84dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/bar_percent"
        style="@style/Text.Caption"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end" />
</LinearLayout>
